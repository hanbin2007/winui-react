{
  "name": "winui-react",
  "version": "0.1.0",
  "description": "An unofficial React UI framework that recreates the WinUI 3 look, feel and motion in the browser.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://hanbin2007.github.io/winui-react/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hanbin2007/winui-react.git"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/winui-react.cjs",
  "module": "./dist/winui-react.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/winui-react.js",
      "require": "./dist/winui-react.cjs"
    },
    "./styles.css": "./dist/winui-react.css"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
